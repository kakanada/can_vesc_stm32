; =====================================================================
; VESC LispBM: универсальный скрипт для пина PPM.
;
; Пин PPM может использоваться в одном из трёх режимов (см. ppm-mode
; ниже) - это ЕДИНСТВЕННАЯ переменная, которую нужно менять при смене
; конфигурации железа на конкретной веске.
;
;   ppm-mode = 0  ->  к PPM подключен ФИЗИЧЕСКИЙ ТОРМОЗ.
;                     Пин работает как ЦИФРОВОЙ ВЫХОД:
;                       1 = тормоз отпущен, 0 = тормоз зажат.
;                     Веска сама решает, крутиться мотору или нет
;                     (см. motor-should-spin), плюс есть возможность
;                     принудительно отпустить тормоз по CAN.
;
;   ppm-mode = 1  ->  к PPM подключен ДАТЧИК/КОНЦЕВИК.
;                     Пин работает как ЦИФРОВОЙ ВХОД, состояние просто
;                     считывается и публикуется в статусе.
;
;   ppm-mode = 2  ->  к PPM НИЧЕГО не подключено. Пин не используется,
;                     статус шлётся с обоими полями "нет данных".
;
; Независимо от режима, 10 раз/сек (и мгновенно при изменении
; состояния) на Extended CAN ID = (can-status-id << 8) | CAN_ID_вески
; уходит статусный пакет 64 бита (8 байт). Расширенный (29-битный) ID,
; а не Standard, и со встроенным собственным CAN ID вески в младшем
; байте - специально для совместимости с motor_vesc.c на стороне STM32,
; который принимает статусы весок именно в таком формате (как и
; официальный протокол VESC: (код_команды << 8) | vesc_id) и иначе
; не сможет ни распознать кадр, ни понять, от какой именно вески он
; пришёл, если весок на шине несколько:
;   байт 0 : тормоз      0x00 - отсутствует/нет данных
;                         0x01 - зажат   (лог. 0 на PPM)
;                         0x02 - отпущен (лог. 1 на PPM)
;   байт 1 : датчик       0x00 - отсутствует/нет данных
;                         0x01 - высокий уровень (лог. 1 на PPM)
;                         0x02 - низкий уровень  (лог. 0 на PPM)
;   байты 2-7 : резерв, всегда 0x00 (для одинаковой длины со всеми
;               остальными статусными пакетами VESC - 8 байт)
;
; В режиме тормоза (ppm-mode = 0) дополнительно принимается CAN-команда
; принудительного отпускания тормоза - тоже Extended CAN ID, в том же
; формате: (can-cmd-id << 8) | CAN_ID_вески (адресована конкретной
; веске, а не широковещательно), 1 байт данных:
;   0x00 - ничего не менять, команда игнорируется
;   0x01 - принудительно ОТПУСТИТЬ тормоз (сторожевой таймер 500 мс -
;          команду нужно повторять чаще, чем раз в 500 мс, иначе
;          управление тормозом автоматически возвращается веске)
;   0x02 - немедленно вернуть тормоз в автономный режим (веска сама
;          решает, отпускать или нет)
;
; =====================================================================


; ==================== 1. КОНФИГУРАЦИЯ (меняется здесь) ================

(define ppm-mode 0)              ; 0 = тормоз, 1 = датчик, 2 = не используется

(define can-status-id 59)        ; код кастомного статуса (см. Extended ID выше)
(define can-cmd-id    60)        ; код команды принудительного отпускания
                                  ; тормоза (актуально только для ppm-mode = 0)

(define status-rate-hz 10)       ; частота отправки статуса, раз/сек
(define status-period  (/ 1.0 status-rate-hz))
(define loop-period     0.02)    ; период основного цикла (50 Гц) -
                                  ; отвечает за быструю реакцию тормоза

(define force-release-timeout 0.5) ; сек, "сторожевой таймер" принудительного
                                    ; отпускания тормоза по CAN

; Режим подтяжки входа для ppm-mode = 1 (датчик/концевик).
; Подберите под схему датчика:
;   'pin-mode-in      - без подтяжки (если на входе уже стоит внешняя)
;   'pin-mode-in-pu   - подтяжка к VCC (датчик замыкает на GND)
;   'pin-mode-in-pd   - подтяжка к GND (датчик замыкает на VCC)
(define sensor-pull-mode 'pin-mode-in-pu)

; Пороги, при превышении которых считаем, что команда на движение
; мотора активна (актуально только для ppm-mode = 0)
(define cur-thd  1.0)            ; А    - порог по току (факт. и заданный)
(define duty-thd 0.005)          ;      - порог по скважности (0..1)
(define pos-thd  0.5)            ; град - порог по ошибке позиционного PID
(define rpm-thd  50.0)           ; ERPM - порог по уставке скоростного PID


; ==================== 2. БЕЗОПАСНЫЙ ВЫЗОВ ФУНКЦИЙ =======================
; Часть функций (get-iq-set, pos-pid-error, get-rpm-set) появились в
; разных версиях прошивки (6.05+ / 6.06+). Если функция недоступна на
; конкретной прошивке или бросает ошибку по другой причине, обычный
; вызов уронит весь скрипт. safe-call перехватывает такую ошибку через
; trap и просто возвращает 0.0 - соответствующее условие в
; motor-should-spin тогда не сработает, но остальные условия и весь
; скрипт продолжат нормально работать.

(defun safe-call (f)
    (var r (trap (f)))
    (match r
        ( (exit-ok (? v)) v )
        ( (exit-error (? e)) 0.0 )
    )
)


; ==================== 3. ЛОГИКА "ДОЛЖЕН ЛИ КРУТИТЬСЯ МОТОР" =============
; Используется только в ppm-mode = 0.
;
; get-current / get-duty есть на любой прошивке (6.00+) и являются
; основной, всегда рабочей проверкой - фактический ток отражает работу
; мотора в ЛЮБОМ режиме управления (ток, duty, позиция, скорость,
; хэндбрейк), т.к. все они в итоге управляют мотором через ток.
;
; get-iq-set / pos-pid-error / get-rpm-set - более "быстрые" и точные
; сигналы (не дожидаются реального тока), добавлены как усиление, но
; обёрнуты в safe-call на случай их отсутствия на вашей прошивке.

(defun motor-should-spin ()
    (or
        (> (abs (get-current))              cur-thd)   ; факт. ток, 6.00+
        (> (abs (get-duty))                 duty-thd)  ; скважность, 6.00+
        (> (abs (safe-call get-iq-set))     cur-thd)    ; заданный ток, 6.05+
        (> (abs (safe-call pos-pid-error))  pos-thd)    ; ошибка позиции, 6.05+
        (> (abs (safe-call get-rpm-set))    rpm-thd)    ; уставка скорости, 6.06+
    )
)


; ==================== 4. ИНИЦИАЛИЗАЦИЯ ПИНА =============================

; Отсоединяем PPM-приложение от пина в любом режиме, чтобы декодер PPM
; не перенастраивал пин и не генерировал импульсы при старте.
(app-ppm-detach 1)

(define brake-released 0)   ; 0 = зажат, 1 = отпущен (используется в mode 0)
(define sensor-level    0)  ; последнее считанное состояние входа (mode 1)

(if (= ppm-mode 0)
    {
        (gpio-configure 'pin-ppm 'pin-mode-out)
        (gpio-write 'pin-ppm 0)      ; безопасное состояние при старте - тормоз зажат
    }
)

(if (= ppm-mode 1)
    (gpio-configure 'pin-ppm sensor-pull-mode)
)

; ppm-mode = 2 - пин не трогаем вообще


; ==================== 5. ПРИЁМ CAN-КОМАНДЫ ПРИНУДИТЕЛЬНОГО ОТПУСКАНИЯ ===
; Кадры используют Extended CAN ID (29 бит) в том же формате, что и
; штатный протокол VESC: (код_команды << 8) | CAN_ID_вески - см.
; пояснение вверху файла. Это нужно, чтобы incoming-команда была
; однозначно адресована именно этой веске (при нескольких вескими на
; шине), а не любой веске, слушающей этот же код команды.

(define my-id (can-local-id))       ; собственный CAN ID этой вески

(define force-release-active 0)     ; 1, пока действует принудительное отпускание
(define force-release-time (systime))

(defun proc-can-eid (id data)
    (var cmd    (bitwise-and (shr id 8) 0xFF))  ; код команды - старший байт ID
    (var target (bitwise-and id 0xFF))          ; адресат - младший байт ID
    (if (and (= cmd can-cmd-id) (= target my-id))
        {
            (var val (ix data 0))
            (if (= val 1)
                {
                    (setvar 'force-release-active 1)
                    (setvar 'force-release-time (systime))
                }
            )
            (if (= val 2)
                (setvar 'force-release-active 0)
            )
            ; val = 0x00 -> ничего не делаем, просто игнорируем
        }
    )
)

(defun can-event-handler ()
    (loopwhile t
        (recv
            ((event-can-eid (? id) . (? data)) (proc-can-eid id data))
            (_ nil)
        )
    )
)

(event-register-handler (spawn can-event-handler))
(event-enable 'event-can-eid)


; ==================== 6. ОТПРАВКА КАСТОМНОГО CAN-СТАТУСА ================
; Тоже Extended CAN ID = (can-status-id << 8) | my-id - см. пояснение
; вверху файла и требования motor_vesc.c на стороне STM32.

(defun get-brake-status-byte ()
    (if (= ppm-mode 0)
        (if (= brake-released 1) 0x02 0x01)
        0x00
    )
)

(defun get-sensor-status-byte ()
    (if (= ppm-mode 1)
        (if (= sensor-level 1) 0x01 0x02)
        0x00
    )
)

(defun send-custom-status ()
    {
        (var buf (bufcreate 8))
        (bufclear buf)                                   ; байты 2-7 остаются 0x00
        (bufset-u8 buf 0 (get-brake-status-byte))
        (bufset-u8 buf 1 (get-sensor-status-byte))
        (can-send-eid (bitwise-or (shl can-status-id 8) my-id) buf)
    }
)


; ==================== 7. ОСНОВНОЙ ЦИКЛ ==================================

(define last-status-time (systime))

(loopwhile t
    {
        (var state-changed 0)

        (if (= ppm-mode 0)
            {
                ; ---- РЕЖИМ 0: К PPM ПОДКЛЮЧЁН ТОРМОЗ ----

                ; Сторожевой таймер принудительного отпускания: если
                ; команда 0x01 не повторяется чаще, чем раз в 500 мс,
                ; автоматически возвращаемся к автономному режиму.
                (if (= force-release-active 1)
                    (if (> (secs-since force-release-time) force-release-timeout)
                        (setvar 'force-release-active 0)
                    )
                )

                (var autonomous-spin (motor-should-spin))
                (var new-state (if (or (= force-release-active 1) autonomous-spin) 1 0))

                (if (not (= new-state brake-released))
                    {
                        (setvar 'brake-released new-state)
                        (gpio-write 'pin-ppm brake-released)
                        (setvar 'state-changed 1)
                    }
                )
            }
        )

        (if (= ppm-mode 1)
            {
                ; ---- РЕЖИМ 1: К PPM ПОДКЛЮЧЁН ДАТЧИК/КОНЦЕВИК ----
                (var level (gpio-read 'pin-ppm))
                (if (not (= level sensor-level))
                    {
                        (setvar 'sensor-level level)
                        (setvar 'state-changed 1)
                    }
                )
            }
        )

        ; ppm-mode = 2 - наблюдать нечего, состояние не меняется

        ; Событийная отправка статуса при изменении состояния
        (if (= state-changed 1)
            {
                (send-custom-status)
                (setvar 'last-status-time (systime))
            }
        )

        ; Периодическая отправка статуса, 10 раз/сек
        (if (> (secs-since last-status-time) status-period)
            {
                (send-custom-status)
                (setvar 'last-status-time (systime))
            }
        )

        (sleep loop-period)
    }
)
